{
    "name": "@iobroker/socket-client-backend",
    "version": "5.2.3",
    "description": "Client libraries for ioBroker using web sockets",
    "main": "build/index.js",
    "scripts": {
        "prepublish": "npm run build",
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint -c eslint.config.mjs",
        "update-packages": "npx -y npm-check-updates --upgrade && cd backend && npx -y npm-check-updates --upgrade",
        "npm": "npm i -f"
    },
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ioBroker/socket-client.git",
        "directory": "backend"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/socket-client/issues"
    },
    "files": [
        "src/",
        "build/",
        "package-lock.json",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/ioBroker/socket-client",
    "dependencies": {
        "@iobroker/socket-client": "^5.2.2",
        "@iobroker/ws": "^3.1.0",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/types": "^7.2.2",
        "@types/node": "^22.20.1",
        "@types/ws": "^8.18.1",
        "typescript": "~6.0.3"
    }
}