{
  "name": "@iobroker/socket-client",
  "version": "5.3.0",
  "description": "Client libraries for ioBroker using web sockets",
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "exports": {
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js",
      "types": "./build/esm/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "build/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "build/esm/index.d.ts": [
        "build/esm/index.d.ts"
      ],
      "build/cjs/index.d.ts": [
        "build/esm/index.d.ts"
      ],
      "*": [
        "build/esm/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node tasks && npm run build:backend",
    "build:backend": "cd backend && npm run build",
    "npm:backend": "cd backend && npm i",
    "postbuild": "esm2cjs --in build/esm --out build/cjs -l error",
    "watch": "npm run build -- --watch",
    "lint": "eslint -c eslint.config.mjs && cd backend && npm run lint",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node -e \"require('node:fs').rmSync('build-test', { recursive: true, force: true })\" && tsc -p test/tsconfig.json && node --test \"build-test/test/**/*.test.js\"",
    "test:backend": "cd backend && npm test",
    "prepare": "npm run build",
    "release": "release-script -lf",
    "release-patch": "release-script patch --yes --lf",
    "release-minor": "release-script minor --yes --lf",
    "release-major": "release-script major --yes --lf",
    "update-packages": "npx -y npm-check-updates --upgrade && cd backend && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd backend && npm i"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/socket-client.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ioBroker/socket-client/issues"
  },
  "files": [
    "src/",
    "build/",
    "package-lock.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ioBroker/socket-client",
  "devDependencies": {
    "@alcalzone/esm2cjs": "^1.4.2",
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/types": "^7.2.3",
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3"
  }
}
